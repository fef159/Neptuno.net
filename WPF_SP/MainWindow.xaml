<Window x:Class="WPF_SP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptuno Manager" Height="800" Width="1280" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
                    <TextBlock Text="N" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Neptuno Manager" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Gestión comercial con WPF, MVVM y SQL Server"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="10" Padding="13,8" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StartupMessage}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Productos" DataContext="{Binding Productos}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="+  Nuevo producto" Style="{StaticResource AccentButton}" Command="{Binding NewCommand}"/>
                        <Button Content="Guardar cambios" Style="{StaticResource OutlineButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                        <Button Content="Desactivar" ToolTip="Baja lógica: establece Activo = 0" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                        <Button Content="Recargar" Style="{StaticResource OutlineButton}" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" IsReadOnly="True" Width="55"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            <DataGridTemplateColumn Header="Proveedor" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ProveedoresDisponibles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedValue="{Binding IdProveedor, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="IdProveedor"
                                                  DisplayMemberPath="NombreCompania"
                                                  Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                                                  BorderBrush="{StaticResource BorderBrush}" Padding="6,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Categoría" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.CategoriasDisponibles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedValue="{Binding IdCategoria, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="IdCategoria"
                                                  DisplayMemberPath="NombreCategoria"
                                                  Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                                                  BorderBrush="{StaticResource BorderBrush}" Padding="6,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Cantidad por unidad" Binding="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Categorías" DataContext="{Binding Categorias}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="+  Nueva categoría" Style="{StaticResource AccentButton}" Command="{Binding NewCommand}"/>
                        <Button Content="Guardar cambios" Style="{StaticResource OutlineButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                        <Button Content="Desactivar" ToolTip="Baja lógica: establece Activo = 0" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                        <Button Content="Recargar" Style="{StaticResource OutlineButton}" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdCategoria}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Proveedores" DataContext="{Binding Proveedores}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Nombre del contacto" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                            <TextBox Width="230" Style="{StaticResource ModernTextBox}" Text="{Binding FiltroContacto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Ciudad" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                            <TextBox Width="190" Style="{StaticResource ModernTextBox}" Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Buscar proveedores" Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}" Margin="10,22,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="+  Nuevo proveedor" Style="{StaticResource AccentButton}" Command="{Binding NewCommand}"/>
                        <Button Content="Guardar cambios" Style="{StaticResource OutlineButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                        <Button Content="Desactivar" ToolTip="Baja lógica: establece Activo = 0" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdProveedor}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Compañía" Binding="{Binding NombreCompania, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                            <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}" Width="1.3*"/>
                            <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="País" Binding="{Binding Pais, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Pedidos" DataContext="{Binding Pedidos}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="+  Nuevo pedido" Style="{StaticResource AccentButton}" Command="{Binding NewCommand}"/>
                        <Button Content="Guardar cambios" Style="{StaticResource OutlineButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                        <Button Content="Desactivar" ToolTip="Baja lógica: establece Activo = 0" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                        <Button Content="Recargar" Style="{StaticResource OutlineButton}" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdPedido}" IsReadOnly="True" Width="55"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding IdCliente, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding IdEmpleado, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Fecha pedido" Binding="{Binding FechaPedido, StringFormat=d, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="Fecha requerida" Binding="{Binding FechaRequerida, StringFormat=d, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Fecha envío" Binding="{Binding FechaEnvio, StringFormat=d, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Transportista" Binding="{Binding TransportistaId, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Destinatario" Binding="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}" Width="1.3*"/>
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding CiudadDestino, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="País" Binding="{Binding PaisDestino, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Reportes manuales" DataContext="{Binding ReportesManuales}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Registrar reporte" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Complete la información manualmente y guárdela."
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16"/>

                                <TextBlock Text="Fecha del reporte" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                                <DatePicker SelectedDate="{Binding FechaReporte}"/>

                                <TextBlock Text="Producto" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,12,0,6"/>
                                <ComboBox ItemsSource="{Binding Productos}" SelectedValue="{Binding ProductoId}"
                                          SelectedValuePath="IdProducto" DisplayMemberPath="NombreProducto"
                                          Height="40" Padding="8" Background="White" Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Text="Cliente" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,12,0,6"/>
                                <ComboBox ItemsSource="{Binding Clientes}" SelectedValue="{Binding ClienteId}"
                                          SelectedValuePath="ClienteID" DisplayMemberPath="Empresa"
                                          Height="40" Padding="8" Background="White" Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Text="Título" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,12,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>

                                <TextBlock Text="Cantidad" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,12,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Detalle u observaciones" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,12,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Detalle, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="85" MaxLength="500"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Guardar reporte" Style="{StaticResource AccentButton}" Command="{Binding GuardarCommand}"/>
                                    <Button Content="Nuevo" Style="{StaticResource OutlineButton}" Command="{Binding NuevoCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Consultar reportes registrados" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Los resultados cambian automáticamente al modificar los filtros."
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="Desde" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FiltroFechaInicio}" Width="145"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Hasta" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FiltroFechaFin}" Width="145"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Producto" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding ProductosFiltro}" SelectedValue="{Binding FiltroProductoId}"
                                              SelectedValuePath="IdProducto" DisplayMemberPath="NombreProducto"
                                              Width="200" Height="40" Padding="8" Background="White" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button Content="Restablecer" Style="{StaticResource OutlineButton}"
                                        Command="{Binding RestablecerFiltrosCommand}" Margin="10,22,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Reportes}" SelectedItem="{Binding SelectedReporte}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ReporteID}" Width="50"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaReporte, StringFormat=d}" Width="90"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="1.2*"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="1.2*"/>
                                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="1.3*"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="75"/>
                                <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="1.6*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Desactivar seleccionado" Style="{StaticResource DangerButton}"
                                    Command="{Binding EliminarCommand}" Margin="12,0,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Detalles de pedidos" DataContext="{Binding Reportes}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,0,14">
                        <TextBlock Text="Consulta de detalles de pedidos" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Escriba o cambie los filtros; la consulta se actualizará automáticamente sin utilizar un botón de generación."
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Fecha inicial" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                            <DatePicker SelectedDate="{Binding FechaInicio, UpdateSourceTrigger=PropertyChanged}" Width="165"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Fecha final" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                            <DatePicker SelectedDate="{Binding FechaFin, UpdateSourceTrigger=PropertyChanged}" Width="165"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Cliente" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                            <TextBox Width="180" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding FiltroCliente, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Producto" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                            <TextBox Width="190" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding FiltroProducto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Restablecer filtros" Style="{StaticResource OutlineButton}" Command="{Binding LimpiarCommand}" Margin="12,22,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Detalles}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding IdPedido}" Width="75"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat=d}" Width="100"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="100"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="85"/>
                            <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat=P0}" Width="95"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
